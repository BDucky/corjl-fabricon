# AWS Configuration (uses Corjl's existing Cognito User Pool)
VITE_AWS_REGION=us-west-2
AWS_REGION=us-west-2

# Cognito Configuration (Corjl's Cognito User Pool — shared with native mobile apps)
VITE_COGNITO_POOL_ID=us-west-2_E6wUbCkj9
VITE_COGNITO_CLIENT_ID=5cu7fdh7uvnfd25nvp1r4c1la4

# S3 Configuration
VITE_S3_BUCKET=corjl-fabricon-storage-1770633739

# Corjl GraphQL API (AppSync endpoint — required for design loading)
VITE_GRAPHQL_ENDPOINT=

# CDN URL for design thumbnails (dev: https://dev.korjl.com, prod: https://www.corjl.com)
VITE_CDN_URL=https://dev.korjl.com

# App Configuration
VITE_APP_ENV=development
VITE_API_ENV=dev

# Replicate (Imagine feature — Step 3 prototype calls Replicate directly from
# the client via CapacitorHttp. Token will be removed from frontend env in
# Step 5 when the call moves into a Lambda. Get a token from
# https://replicate.com/account/api-tokens.)
VITE_REPLICATE_API_TOKEN=
# Optional model overrides (owner/name). The Imagine flow routes per-product:
# garment products → VITE_REPLICATE_MODEL_GARMENT (default cuuupid/idm-vton)
# everything else  → VITE_REPLICATE_MODEL_FACE    (default bytedance/flux-pulid)
# VITE_REPLICATE_MODEL_GARMENT=cuuupid/idm-vton
# VITE_REPLICATE_MODEL_FACE=bytedance/flux-pulid

# Capacitor live-reload (optional, dev-only).
# When set, the iOS/Android app loads from this URL instead of the bundled
# webDir, so changes hot-reload on your phone. Use your Mac's LAN IP, not
# localhost. Find it with: ipconfig getifaddr en0
# Leave unset (or remove) for release / TestFlight builds.
# CAPACITOR_SERVER_URL=http://192.168.1.x:5173
